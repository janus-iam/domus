# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Public app URLs — appear in redirects/CORS, so they must not be leak-scanned
# @public @type=url
BETTER_AUTH_URL=

# @public @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Keycloak realm URL, for example https://keycloak.example.com/realms/domus
# @public @type=url
KEYCLOAK_ISSUER=

# Public OIDC client id (PKCE public client)
# @public @type=string(minLength=1)
KEYCLOAK_CLIENT_ID=
