# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Public app URLs — appear in redirects/CORS, so they must not be leak-scanned
# @public @type=url
BETTER_AUTH_URL=http://localhost:3000

# @public @type=url
CORS_ORIGIN=http://localhost:3001

# @type=string(minLength=1)
DATABASE_URL=

# Keycloak realm URL, for example https://keycloak.example.com/realms/domus
# @public @type=url
KEYCLOAK_ISSUER=https://auth.getjanus.eu/realms/dev

# Public OIDC client id (PKCE public client)
# @public @type=string(minLength=1)
KEYCLOAK_CLIENT_ID=domus-web

# ClickHouse (events.getjanus.eu)
# @public @type=url
CLICKHOUSE_URL=https://events.getjanus.eu

# Username is not a secret (often "default") and appears in many responses
# @public @type=string(minLength=1)
CLICKHOUSE_USER=default

# @type=string
CLICKHOUSE_PASSWORD=

# Database name is not a secret; may appear in errors/UI
# @public @type=string(minLength=1)
CLICKHOUSE_DATABASE=keycloak_events

# @public @type=string(minLength=1)
CLICKHOUSE_EVENTS_TABLE=events
